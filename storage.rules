rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isSafeReceipt() {
      return request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('(image/png|image/jpeg|image/webp|application/pdf)');
    }

    match /receipts/{uid}/{fileName} {
      allow read: if isOwner(uid) || request.auth.token.admin == true;
      allow create: if isOwner(uid) && isSafeReceipt();
      allow update, delete: if false;
    }

    match /avatars/{uid}/{fileName} {
      allow read: if true;
      allow create, update: if isOwner(uid)
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|webp)');
      allow delete: if isOwner(uid);
    }
  }
}
